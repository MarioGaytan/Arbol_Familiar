# Copia este archivo como .env (el .env NUNCA se sube a git).

# --- Base de datos ---
# Local (docker compose):
DATABASE_URL=postgres://arbol:arbol@localhost:5440/arbol
# En Railway se usa: DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_SSL=true      # sólo si el proveedor lo exige (Neon/Supabase); Railway interno no lo necesita
PORT=3001

# --- Cloudflare R2 (fotos) ---
# Déjalas vacías en desarrollo: las fotos se guardan en server/uploads.
# En producción son obligatorias (el disco de Railway se borra en cada despliegue).
# Comprobar con:  npm run r2:check -w server -- https://tu-dominio.com
# R2_ACCOUNT_ID=          # Cloudflare → R2 → "Account ID" (columna derecha)
# R2_ACCESS_KEY_ID=       # del token de API de R2 (Object Read & Write, sólo ese bucket)
# R2_SECRET_ACCESS_KEY=   # se muestra UNA sola vez al crear el token
# R2_BUCKET=arbol-fotos
# R2_PUBLIC_URL=https://fotos.tudominio.com   # dominio propio conectado al bucket (o la URL r2.dev para pruebas)

# Días que se conserva una foto que ya nadie usa antes de borrarla (permite "deshacer")
# PHOTO_GRACE_DAYS=7

# --- Protección de datos (LFPDPPP) ---
# Obligatorias en producción: identifican al responsable en el Aviso de Privacidad.
# LEGAL_CONTROLLER_NAME="Tu nombre o razón social"
# LEGAL_CONTROLLER_ADDRESS="Calle, número, colonia, ciudad, estado, C.P., México"
# LEGAL_CONTACT_EMAIL=privacidad@tudominio.com
# PUBLIC_SITE_URL=https://tudominio.com

# Sólo para probar la imagen de producción en local sin certificado (NUNCA en Railway)
# FORCE_HTTPS=false
